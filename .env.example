# Copy to .env and fill in real values. Never commit .env.

# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=123456
# The .pem contents, not a file path. Use \n for line breaks on a single line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-me\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me

# Hostnames below are the Docker Compose service names. For local runs outside Docker,
# use localhost instead of redis / postgres.
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+psycopg://themis:themis@postgres:5432/themis

# Langfuse cloud (ADR-013)
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

LOG_LEVEL=INFO

# LLM providers via LiteLLM, free tiers only (ADR-021). Leave a key empty to skip that provider.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Order to try providers in, and the model per provider. Configuration, not code.
LLM_PROVIDER_CASCADE=["groq", "gemini", "mistral", "openrouter"]
LLM_MODELS={"groq": "openai/gpt-oss-120b", "gemini": "gemini-3.5-flash", "mistral": "codestral-2508", "openrouter": "qwen/qwen3.8-27b:free"}
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
